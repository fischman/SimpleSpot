#!/bin/bash

set -euo pipefail

cd "$(dirname "$0")/.."

IMAGE="simplespot-tests"

docker image inspect "$IMAGE" >/dev/null 2>&1 || { echo "$IMAGE missing; build it with $(dirname "$0")/build" >&2 ; exit 1; }

exec docker run --pull=never --rm --network=none -v "$PWD:/work" -w /work "$IMAGE" test/run.py
